# Local development only. Never commit real credentials.
ENVIRONMENT=development
GROWTH360_ADMIN_TOKEN=replace-with-a-random-secret-at-least-32-characters
GROWTH360_DB=./growth360.db
ANALYZE_PER_MINUTE=3
PAGESPEED_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Optional future provider; not currently wired into report generation.
SIMILARWEB_API_KEY=

# Optional: OpenAI Responses API for generated ad concepts
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra